<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_my_home" inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="after">
            <div
                t-if="env.user.create_booking_from_portal or env.user.has_group('base.group_system')"
            >
                <h3>Actions</h3>
                <div class="o_portal_actions list-group">
                    <t t-call="resource_booking_portal.portal_docs_action">
                        <t t-set="title">Create a booking</t>
                        <t t-set="url" t-value="'/my/bookings/prepare/form'" />
                    </t>
                </div>
            </div>
        </xpath>
    </template>

    <template id="portal_docs_action" name="My Portal Action Entry">
        <a
            t-att-href="url"
            t-att-title="title"
            class="list-group-item list-group-item-action d-flex align-items-center justify-content-between"
        >
            <t t-esc="title" />
        </a>
    </template>

    <template
        id="portal_my_home_menu"
        name="Portal layout : creating"
        inherit_id="portal.portal_breadcrumbs"
        priority="20"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li
                t-if="page_name == 'create_booking'"
                t-attf-class="breadcrumb-item active"
            >
                <span>Create booking</span>
            </li>
        </xpath>
    </template>

    <template id="booking_create_form" name="Booking Create Form">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <div class="row">
                    <div class="col-12">
                        <form action="/my/bookings/create" method="post">
                            <input
                                type="hidden"
                                name="csrf_token"
                                t-att-value="request.csrf_token()"
                            />
                            <div class="form-row">
                                <div class="col-12 mb-1">
                                    <label
                                        class="text-primary"
                                        for='resource_name'
                                    >Name</label>
                                    <input
                                        class="form-control"
                                        name="name"
                                        type="text"
                                        id="resource_name"
                                        placeholder="Resource Name"
                                        required="required"
                                    />
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="col-12 mb-1 mt-1">
                                    <label
                                        class="text-primary"
                                        for="resource_type"
                                    >Type</label>
                                    <select
                                        class="form-control"
                                        name="type"
                                        id="resource_type"
                                        required="required"
                                    >
                                        <t t-foreach="types" t-as="type">
                                            <option t-attf-value="#{type['id']}">
                                                <span t-esc="type['name']" />
                                            </option>
                                        </t>
                                    </select>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="col-12 mb-1 mt-1">
                                    <label
                                        class="text-primary"
                                        for="resource_description"
                                    >Description</label>
                                    <textarea
                                        class="form-control"
                                        name="description"
                                        id="resource_description"
                                        rows="3"
                                    />
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="col-12 mt-1">
                                    <button
                                        type="submit"
                                        class="btn btn-primary float-right"
                                    >Continue</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>


    <template
        id="scheduling_calendar"
        inherit_id="resource_booking.scheduling_calendar"
    >
        <xpath expr="//t[contains(@t-set, 'confirm_url')]" position="attributes">
            <attribute
                name="t-value"
            >booking.get_portal_url(suffix= '/reserve')</attribute>
        </xpath>
    </template>

    <template id="portal_my_bookings" inherit_id="resource_booking.portal_my_bookings">
        <xpath expr="//t[@t-if='not bookings']" position="before">
            <div t-if="request.env.user.create_booking_from_portal">
                <button
                    class="btn btn-primary"
                    name='new_booking'
                    data-bs-toggle="modal"
                    data-bs-target=".modal_new_booking"
                    title="Add a booking"
                    aria-label="Add a booking"
                >
                    Create booking
                </button>
            </div>
            <div class="modal fade modal_new_booking" role="form">
                <div class="modal-dialog">
                    <form
                        method="POST"
                        class="modal-content js_website_submit_form new_booking_form"
                    >
                        <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="request.csrf_token()"
                        />
                        <header class="modal-header">
                            <h4 class="modal-title">New Booking</h4>
                            <button
                                type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close"
                            />
                        </header>
                        <main class="modal-body" id="new-booking-dialog">
                            <div class="mb-3">
                                <label
                                    class="col-form-label hdd4"
                                    for="resource_name"
                                >Resource Name</label>
                                <input
                                    type='text'
                                    name="resource_name"
                                    class="form-control resource_name"
                                    required="required"
                                />
                            </div>
                            <div class="mb-3">
                                <label
                                    class="col-form-label h4dd"
                                    for="resource_type"
                                >Type</label>
                                <select
                                    name="resource_type"
                                    class="form-select resource_type"
                                    required="required"
                                >
                                    <option
                                        disabled="disabled"
                                        value=""
                                    >Select the type...</option>
                                    <t t-foreach="booking_types" t-as="booking_type">
                                        <option t-attf-value="#{booking_type['id']}">
                                            <t t-out="booking_type['name']" />
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label
                                    class="col-form-label hdd4"
                                    for="resource_description"
                                >Description</label>
                                <textarea
                                    rows="3"
                                    name="resource_description"
                                    class="form-control description"
                                />
                            </div>
                        </main>
                        <footer class="modal-footer">
                            <button
                                type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal"
                            >
                                Cancel</button>
                            <button
                                t-attf-class="btn btn-primary new_booking_confirm"
                            >Confirm</button>
                        </footer>
                    </form>
                </div>
            </div>

        </xpath>
    </template>

</odoo>
